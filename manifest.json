{
  "manifest_version": 3,
  "name": "Story Reader & Translator",
  "version": "0.5.13",
  "description": "Đọc truyện, dịch trang, tự cuộn — hoạt động trên mọi trang web",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "libs/readability.js",
        "content-scripts/detector.js",
        "content-scripts/tts-engine.js",
        "content-scripts/floating-toolbar.js"
      ],
      "css": ["ui/floating-toolbar.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}